<Page x:Class="AdofaiModManager.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:svc="clr-namespace:AdofaiModManager.Services"
      xmlns:loc="clr-namespace:AdofaiModManager.Services"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="{loc:Tr Settings_Title}">
    <ScrollViewer svc:SmoothScroll.IsEnabled="True" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock FontSize="30" FontWeight="SemiBold" Text="{loc:Tr Settings_Title}" />

            <!-- 语言 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="{loc:Tr Settings_Language}" />
            <ComboBox x:Name="LanguageCombo"
                      Width="240"
                      HorizontalAlignment="Left"
                      SelectionChanged="Language_Changed">
                <ComboBoxItem Content="{loc:Tr Settings_LanguageSystem}" Tag="system" />
                <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                <ComboBoxItem Content="繁體中文" Tag="zh-Hant" />
                <ComboBoxItem Content="日本語" Tag="ja" />
                <ComboBoxItem Content="한국어" Tag="ko" />
                <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
            <TextBlock Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.6"
                       Text="{loc:Tr Settings_LanguageHint}"
                       TextWrapping="Wrap" />

            <!-- 外观 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="{loc:Tr Settings_Appearance}" />
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ThemeSystem"
                             Margin="0,0,24,0"
                             Checked="Theme_Checked"
                             Content="{loc:Tr Settings_ThemeSystem}"
                             GroupName="Theme"
                             Tag="System" />
                <RadioButton x:Name="ThemeLight"
                             Margin="0,0,24,0"
                             Checked="Theme_Checked"
                             Content="{loc:Tr Settings_ThemeLight}"
                             GroupName="Theme"
                             Tag="Light" />
                <RadioButton x:Name="ThemeDark"
                             Checked="Theme_Checked"
                             Content="{loc:Tr Settings_ThemeDark}"
                             GroupName="Theme"
                             Tag="Dark" />
            </StackPanel>
            <TextBlock Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.6"
                       Text="{loc:Tr Settings_ThemeHint}"
                       TextWrapping="Wrap" />

            <!-- 游戏目录 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="{loc:Tr Settings_GameDir}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="GamePathBox"
                            Grid.Column="0"
                            PlaceholderText="{loc:Tr Settings_GamePathPlaceholder}"
                            TextChanged="GamePathBox_TextChanged" />
                <ui:Button x:Name="AutoDetectButton"
                           Grid.Column="1"
                           Margin="8,0,0,0"
                           Click="AutoDetectButton_Click"
                           Content="{loc:Tr Settings_Detect}"
                           Icon="{ui:SymbolIcon Symbol=Search24}" />
                <ui:Button x:Name="BrowseButton"
                           Grid.Column="2"
                           Margin="8,0,0,0"
                           Click="BrowseButton_Click"
                           Content="{loc:Tr Settings_Browse}"
                           Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
            </Grid>
            <TextBlock x:Name="GameStatusText"
                       Margin="0,8,0,0"
                       Opacity="0.7"
                       TextWrapping="Wrap" />

            <TextBlock Margin="0,16,0,8" FontSize="14" FontWeight="SemiBold" Text="{loc:Tr Settings_GameVersion}" />
            <ui:TextBox x:Name="GameVersionBox"
                        PlaceholderText="{loc:Tr Settings_GameVersionPlaceholder}"
                        TextChanged="GameVersionBox_TextChanged" />
            <TextBlock x:Name="GameVersionStatusText"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap" />

            <!-- 来源总览 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="{loc:Tr Settings_Source}" />
            <TextBlock Margin="0,0,0,6"
                       FontSize="12"
                       Opacity="0.6"
                       Text="{loc:Tr Settings_SourceHint}"
                       TextWrapping="Wrap" />
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SourceSiteNameText"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="ADOFAITools" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                    <Hyperlink x:Name="SourceSiteHyperlink" />
                </TextBlock>
            </Grid>
            <Grid x:Name="CustomSourceRow" Margin="0,4,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="CustomSourceNameText" Grid.Column="0" VerticalAlignment="Center" />
                <TextBlock x:Name="CustomSourceUrlText"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           Opacity="0.8" />
            </Grid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="TUF" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://tuforums.com/mods">https://tuforums.com/mods</Hyperlink>
                </TextBlock>
            </Grid>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="modlist" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center">
                    <Hyperlink NavigateUri="https://modlist.org">https://modlist.org</Hyperlink>
                </TextBlock>
            </Grid>

            <!-- 默认站点（名称随配置） -->
            <TextBlock x:Name="SiteSectionTitle"
                       Margin="0,32,0,8"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Text="ADOFAITools" />
            <TextBlock Margin="0,0,0,4" FontSize="12" Opacity="0.6" Text="{loc:Tr Settings_SiteUrl}" />
            <ui:TextBox x:Name="ApiBaseUrlBox"
                        PlaceholderText="https://www.adofaitools.top"
                        TextChanged="ApiBaseUrlBox_TextChanged" />
            <TextBlock Margin="0,10,0,4"
                       FontSize="12"
                       Opacity="0.6"
                       Text="{loc:Tr Settings_ApiKey}" />
            <ui:PasswordBox x:Name="ApiKeyBox"
                            PasswordChar="●"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            PasswordChanged="ApiKeyBox_PasswordChanged"
                            RevealButtonEnabled="True" />
            <TextBlock Margin="0,10,0,4"
                       FontSize="12"
                       Opacity="0.6"
                       Text="{loc:Tr Settings_SiteDisplayName}" />
            <ui:TextBox x:Name="SiteNameBox"
                        PlaceholderText="{loc:Tr Settings_SiteDisplayNamePlaceholder}"
                        TextChanged="SiteNameBox_TextChanged" />
            <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                <ui:Button Click="TestApi_Click"
                           Content="{loc:Tr Settings_Test}"
                           Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                <ui:Button Margin="8,0,0,0" Click="OpenSite_Click" Content="{loc:Tr Settings_OpenSite}" />
            </StackPanel>
            <TextBlock x:Name="ApiStatusText"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.6"
                       Text="{loc:Tr Settings_SiteHint}"
                       TextWrapping="Wrap" />

            <!-- 自定义站点 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="{loc:Tr Settings_CustomSite}" />
            <TextBlock Margin="0,0,0,8"
                       FontSize="12"
                       Opacity="0.6"
                       Text="{loc:Tr Settings_CustomSiteHint}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,0,0,4" FontSize="12" Opacity="0.6" Text="{loc:Tr Settings_CustomSiteName}" />
            <ui:TextBox x:Name="CustomSiteNameBox"
                        PlaceholderText="{loc:Tr Settings_CustomSiteNamePlaceholder}"
                        TextChanged="CustomSite_TextChanged" />
            <TextBlock Margin="0,10,0,4" FontSize="12" Opacity="0.6" Text="{loc:Tr Settings_SiteUrl}" />
            <ui:TextBox x:Name="CustomSiteUrlBox"
                        PlaceholderText="https://example.com"
                        TextChanged="CustomSite_TextChanged" />
            <TextBlock Margin="0,10,0,4" FontSize="12" Opacity="0.6" Text="{loc:Tr Settings_CustomSiteKey}" />
            <ui:PasswordBox x:Name="CustomSiteKeyBox"
                            PasswordChar="●"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            PasswordChanged="CustomSiteKey_Changed"
                            RevealButtonEnabled="True" />

            <!-- 更新检查 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="{loc:Tr Settings_Updates}" />
            <CheckBox x:Name="CheckOnStartupBox"
                      Checked="CheckOnStartup_Changed"
                      Content="{loc:Tr Settings_CheckStartup}"
                      Unchecked="CheckOnStartup_Changed" />
            <CheckBox x:Name="CheckGitHubBox"
                      Margin="0,10,0,0"
                      Checked="CheckGitHub_Changed"
                      Content="{loc:Tr Settings_CheckGitHub}"
                      Unchecked="CheckGitHub_Changed" />
            <TextBlock Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.6"
                       Text="{loc:Tr Settings_UpdateHint}"
                       TextWrapping="Wrap" />

            <!-- 其它 -->
            <StackPanel x:Name="RerunWizardPanel">
                <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="{loc:Tr Settings_Other}" />
                <ui:Button HorizontalAlignment="Left"
                           Click="RerunWizard_Click"
                           Content="{loc:Tr Settings_RerunWizard}" />
            </StackPanel>

            <!-- 关于 -->
            <TextBlock Margin="0,32,0,8" FontSize="16" FontWeight="SemiBold" Text="{loc:Tr Settings_About}" />
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="AppVersionText"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <ui:Button Margin="12,0,0,0"
                           Click="CheckAppUpdate_Click"
                           Content="{loc:Tr Settings_CheckUpdate}"
                           Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                <ui:Button x:Name="AppUpdateNowButton"
                           Margin="8,0,0,0"
                           Appearance="Primary"
                           Click="AppUpdateNow_Click"
                           Content="{loc:Tr Settings_UpdateNow}"
                           Icon="{ui:SymbolIcon Symbol=ArrowDownload24}"
                           ToolTip="{loc:Tr Settings_UpdateNowTip}"
                           Visibility="Collapsed" />
            </StackPanel>
            <ProgressBar x:Name="AppUpdateProgress"
                         Height="4"
                         Margin="0,10,0,0"
                         Visibility="Collapsed" />
            <TextBlock x:Name="AppUpdateStatusText"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.75"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,12,0,0"
                       Opacity="0.7"
                       Text="{loc:Tr Settings_License}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ConfigPathText"
                       Margin="0,8,0,0"
                       FontSize="12"
                       Opacity="0.5"
                       TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</Page>
