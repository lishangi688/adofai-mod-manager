<ui:FluentWindow x:Class="AdofaiModManager.MainWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                xmlns:pages="clr-namespace:AdofaiModManager.Views.Pages"
                Title="ADOFAI Mod Manager"
                Icon="pack://application:,,,/Assets/app.ico"
                Width="1200"
                Height="780"
                MinWidth="920"
                MinHeight="620"
                ExtendsContentIntoTitleBar="True"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                WindowBackdropType="Mica"
                WindowCornerPreference="Round"
                WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="ADOFAI Mod Manager">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app-128.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- AMM 自身有新版本时的提示条（可关闭，「忽略此版本」后不再重复提示） -->
        <ui:InfoBar x:Name="AppUpdateBar"
                    Grid.Row="1"
                    Margin="236,12,24,0"
                    VerticalAlignment="Top"
                    IsClosable="True"
                    IsOpen="False"
                    Panel.ZIndex="100"
                    Severity="Informational"
                    Title="AMM 有新版本">
            <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                <TextBlock x:Name="AppUpdateText"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <ui:Button Margin="12,0,0,0"
                           Click="OpenAppRelease_Click"
                           Content="打开发布页" />
                <ui:Button Margin="8,0,0,0"
                           Click="SkipAppVersion_Click"
                           Content="忽略此版本" />
            </StackPanel>
        </ui:InfoBar>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           OpenPaneLength="220"
                           PaneDisplayMode="Left"
                           SelectionChanged="RootNavigation_SelectionChanged"
                           Transition="FadeInWithSlide">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="在线 Mod"
                                       FocusVisualStyle="{x:Null}"
                                       Icon="{ui:SymbolIcon Symbol=CloudArrowDown24}"
                                       TargetPageType="{x:Type pages:OnlineModsPage}" />
                <ui:NavigationViewItem x:Name="InstalledNavItem"
                                       Content="已安装"
                                       FocusVisualStyle="{x:Null}"
                                       Icon="{ui:SymbolIcon Symbol=Apps24}"
                                       TargetPageType="{x:Type pages:InstalledModsPage}" />
                <ui:NavigationViewItem Content="收藏"
                                       FocusVisualStyle="{x:Null}"
                                       Icon="{ui:SymbolIcon Symbol=Star24}"
                                       TargetPageType="{x:Type pages:FavoritesPage}" />
                <ui:NavigationViewItem Content="UMM 环境"
                                       FocusVisualStyle="{x:Null}"
                                       Icon="{ui:SymbolIcon Symbol=Wrench24}"
                                       TargetPageType="{x:Type pages:LoaderPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="设置"
                                       Icon="{ui:SymbolIcon Symbol=Settings24}"
                                       TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
