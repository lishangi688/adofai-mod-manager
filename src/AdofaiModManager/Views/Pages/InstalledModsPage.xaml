<Page x:Class="AdofaiModManager.Views.Pages.InstalledModsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:svc="clr-namespace:AdofaiModManager.Services"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="已安装">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="已安装的 Mod" />
                <TextBlock x:Name="SummaryText"
                           Margin="0,4,0,0"
                           Opacity="0.6"
                           Text="正在读取…" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <ui:Button x:Name="CheckAllButton"
                           Margin="0,0,8,0"
                           Click="CheckAll_Click"
                           Content="检查全部更新"
                           Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                <ui:Button Margin="0,0,8,0"
                           Click="Refresh_Click"
                           Content="刷新"
                           Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" />
                <ui:Button Appearance="Primary"
                           Click="InstallZip_Click"
                           Content="安装本地 zip"
                           Icon="{ui:SymbolIcon Symbol=ArrowDownload24}" />
            </StackPanel>
        </DockPanel>

        <ui:InfoBar x:Name="StatusBar"
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    IsClosable="True"
                    IsOpen="False" />

        <ScrollViewer x:Name="ModsScroller" svc:SmoothScroll.IsEnabled="True" Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="ModsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,12,8"
                                    Padding="14"
                                    Background="{DynamicResource AmmCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource AmmCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- 第一行：基本信息与常用操作 -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="44"
                                                Height="44"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                CornerRadius="10">
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Initial}" />
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="14,0,14,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding DisplayName}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Subtitle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,1,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding ExtraInfo}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,1,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding RequirementsLabel}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,1,0,0"
                                                       FontSize="12"
                                                       Foreground="#E06C5A"
                                                       Text="{Binding CompatibilityWarning}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <CheckBox Margin="0,0,12,0"
                                                      VerticalAlignment="Center"
                                                      Click="ToggleEnabled_Click"
                                                      Content="启用"
                                                      IsChecked="{Binding IsEnabled, Mode=OneWay}" />
                                            <ui:Button Margin="0,0,6,0"
                                                       Click="OpenFolder_Click"
                                                       Icon="{ui:SymbolIcon Symbol=FolderOpen24}"
                                                       ToolTip="打开文件夹" />
                                            <ui:Button Click="Uninstall_Click" Content="卸载" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- 第二行：更新 -->
                                    <Grid Grid.Row="1" Margin="58,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontSize="11"
                                                       Opacity="0.5"
                                                       Text="{Binding UpdateSourceLabel}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12"
                                                       Foreground="#2E9E5B"
                                                       Text="{Binding UpdateStatus}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button Margin="0,0,6,0"
                                                       Click="CheckUpdate_Click"
                                                       Content="检查更新" />
                                            <ui:Button Margin="0,0,6,0"
                                                       Appearance="Primary"
                                                       Click="Update_Click"
                                                       Content="更新"
                                                       Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                                            <ui:Button Click="BindGitHub_Click" Content="绑定 GitHub" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock x:Name="EmptyHint"
                           Margin="0,80,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           FontSize="14"
                           Opacity="0.55"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
