<Page x:Class="AdofaiModManager.Views.Pages.LoaderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:svc="clr-namespace:AdofaiModManager.Services"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Title="UMM 环境">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock FontSize="28" FontWeight="SemiBold" Text="UMM 环境" />
            <TextBlock x:Name="SubtitleText"
                       Margin="0,4,0,0"
                       Opacity="0.6"
                       TextWrapping="Wrap"
                       Text="检测和管理游戏里的 mod 加载器（原本由 UnityModManager 负责注入）。" />
        </StackPanel>

        <ui:InfoBar x:Name="StatusBar"
                    Grid.Row="1"
                    Margin="0,12,0,0"
                    IsClosable="True"
                    IsOpen="False" />

        <ScrollViewer svc:SmoothScroll.IsEnabled="True" Grid.Row="2" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <Border Padding="20"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock x:Name="StateText" FontSize="18" FontWeight="SemiBold" Text="检测中…" />
                    <TextBlock x:Name="DetailText"
                               Margin="0,10,0,0"
                               LineHeight="24"
                               Opacity="0.82"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0,24,0,10" FontSize="16" FontWeight="SemiBold" Text="操作" />
            <WrapPanel>
                <ui:Button x:Name="InstallButton"
                           Margin="0,0,8,8"
                           Appearance="Primary"
                           Click="Install_Click"
                           Content="安装 / 修复加载器"
                           Icon="{ui:SymbolIcon Symbol=ShieldCheckmark24}" />
                <ui:Button x:Name="CheckUpdateButton"
                           Margin="0,0,8,8"
                           Click="CheckUpdate_Click"
                           Content="检查内核更新"
                           Icon="{ui:SymbolIcon Symbol=ArrowSync24}" />
                <ui:Button x:Name="RollbackButton"
                           Margin="0,0,8,8"
                           Click="Rollback_Click"
                           Content="回滚内核"
                           Icon="{ui:SymbolIcon Symbol=ArrowUndo24}" />
                <ui:Button x:Name="UninstallButton"
                           Margin="0,0,8,8"
                           Click="Uninstall_Click"
                           Content="卸载加载器"
                           Icon="{ui:SymbolIcon Symbol=Delete24}" />
                <ui:Button Margin="0,0,8,8"
                           Click="OpenGameFolder_Click"
                           Content="打开游戏目录"
                           Icon="{ui:SymbolIcon Symbol=FolderOpen24}" />
                <ui:Button x:Name="LaunchSteamButton"
                           Margin="0,0,8,8"
                           Click="Launch_Click"
                           Content="Steam 启动"
                           ToolTip="通过 Steam 启动：成就、云存档、游玩时长都正常记录（推荐）">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="XboxController24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Margin="0,0,8,8"
                           Click="LaunchDirect_Click"
                           Content="直接启动"
                           Icon="{ui:SymbolIcon Symbol=Flash24}"
                           ToolTip="直接运行游戏 exe：启动更快、不必等 Steam；但成就 / 云存档可能不同步" />
            </WrapPanel>

            <TextBlock Margin="0,16,0,0"
                       FontSize="12"
                       Opacity="0.55"
                       TextWrapping="Wrap"
                       Text="说明：加载器采用 UnityDoorstop（DoorstopProxy）方式注入，只会在游戏目录写入 winhttp.dll、doorstop_config.ini，并在 ..._Data\Managed\UnityModManager 下放置加载器文件。卸载会移除这些文件（不影响 Mods 里的 mod）。" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
